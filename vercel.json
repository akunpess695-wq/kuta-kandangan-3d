{\n  \"version\": 2,\n  \"cleanUrls\": true,\n  \"headers\": [\n    {\n      \"source\": \"/(.*)\",\n      \"headers\": [\n        {\n          \"key\": \"Cross-Origin-Opener-Policy\",\n          \"value\": \"same-origin-allow-popups\"\n        },\n        {\
          \"key\": \"X-Content-Type-Options\",\n          \"value\": \"nosniff\"\n        }\n      ]\n    },\n    {\n      \"source\": \"/assets/3d/(.*)\\.glb\",\n      \"headers\": [\n        {\
          \"key\": \"Content-Type\",\n          \"value\": \"model/gltf-binary\"\n        },\n        {\
          \"key\": \"Cache-Control\",\n          \"value\": \"public, max-age=31536000, immutable\"\n        }\n      ]\n    }\n  ]\n}